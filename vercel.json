{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/shop.js": { "maxDuration": 40 }
  },
  "rewrites": [
    { "source": "/config.json", "destination": "/api/shop" },
    { "source": "/checkout", "destination": "/api/shop" }
  ]
}
